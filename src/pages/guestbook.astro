---
import { Icon } from "astro-icon/components";
import { sayingsData } from "@/config/sayingsConfig";
import { commentConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

if (!siteConfig.pages.guestbook) {
	return Astro.redirect("/404/");
}

const title = i18n(I18nKey.guestbook);
const description = i18n(I18nKey.guestbookDescription);
const description2 = i18n(I18nKey.guestbookDescription2);

const isArtalkEnabled = commentConfig.type === "artalk";
const artalkConfig = isArtalkEnabled ? {
	server: commentConfig.artalk?.server || "",
	site: siteConfig.title,
	locale: commentConfig.artalk?.locale || "zh-CN",
	dark: "html.dark",
} : null;
const artalkConfigStr = artalkConfig ? JSON.stringify(artalkConfig) : "";
---

<MainGridLayout title={title} description={description}>
  <!-- Artalk CSS -->
  {isArtalkEnabled && (
    <link rel="stylesheet" href="https://unpkg.com/artalk/dist/Artalk.css" slot="head" />
  )}

  <!-- 页面头部 -->
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative">
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <div class="mb-6">
        <div class="flex items-center gap-3 mb-3">
          <div class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70">
            <Icon name="material-symbols:chat-bubble-outline" class="text-[1.5rem]"></Icon>
          </div>
          <div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
            {title}
          </div>
        </div>
        <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
          {description}
        </p>
        <p class="text-sm text-neutral-500 dark:text-neutral-500 mt-1">
          {description2}
        </p>
      </div>
    </div>
  </div>

  <!-- 说说列表 -->
  <div class="mt-4 flex flex-col gap-4">
    {sayingsData.map((saying) => (
      <div class="card-base rounded-(--radius-large) overflow-hidden relative group saying-card" data-saying-id={saying.id}>
        <div class="px-6 py-5">
          <!-- 头部：头像 + 昵称 + 时间 -->
          <div class="flex items-start gap-3 mb-3">
            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-(--primary) to-purple-400 flex items-center justify-center shrink-0 text-white font-bold text-sm shadow-md">
              H
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="font-bold text-neutral-900 dark:text-neutral-100 text-sm">
                  {siteConfig.navbar.title}
                </span>
                {saying.tags && saying.tags.map((tag) => (
                  <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-(--primary)/10 text-(--primary) font-medium">
                    {tag}
                  </span>
                ))}
              </div>
              <div class="flex items-center gap-2 text-xs text-neutral-400 dark:text-neutral-500 mt-0.5">
                <span>{saying.time}</span>
                {saying.location && (
                  <>
                    <span>·</span>
                    <span class="flex items-center gap-0.5">
                      <Icon name="material-symbols:location-on-outline" class="text-[12px]" />
                      {saying.location}
                    </span>
                  </>
                )}
              </div>
            </div>
          </div>

          <!-- 内容 -->
          <div class="pl-13 text-[15px] leading-relaxed text-neutral-800 dark:text-neutral-200 whitespace-pre-line">
            {saying.content}
          </div>

          <!-- 媒体：图片/视频 -->
          {saying.media && saying.media.length > 0 && (
            <div class:list={[
              "pl-13 mt-3 gap-2",
              saying.media.length === 1 ? "grid grid-cols-1 max-w-[320px]" :
              saying.media.length === 4 ? "grid grid-cols-2 max-w-[320px]" :
              "grid grid-cols-3",
            ]}>
              {saying.media.map((item) => (
                item.type === "image" ? (
                  <div class="rounded-lg overflow-hidden aspect-square bg-neutral-100 dark:bg-neutral-800 cursor-pointer hover:opacity-90 transition-opacity">
                    <img src={item.url} alt="" class="w-full h-full object-cover" loading="lazy" />
                  </div>
                ) : (
                  <div class="rounded-lg overflow-hidden aspect-square bg-neutral-900 relative group/video">
                    <video
                      src={item.url}
                      poster={item.poster}
                      controls
                      preload="metadata"
                      class="w-full h-full object-cover"
                      playsinline
                    />
                  </div>
                )
              ))}
            </div>
          )}

          <!-- 分割线 + 互动栏 -->
          <div class="border-t border-neutral-100 dark:border-neutral-700/50 mt-4 pt-3">
            <div class="flex items-center gap-6 text-neutral-400 dark:text-neutral-500">
              <button class="flex items-center gap-1.5 hover:text-red-400 transition-colors duration-200 text-sm group/like btn-like" data-id={saying.id}>
                <Icon name="material-symbols:favorite-outline" class="text-[18px] group-hover/like:text-red-400" />
                <span class="like-count">{saying.likes}</span>
              </button>
              {isArtalkEnabled && (
                <button class="flex items-center gap-1.5 hover:text-(--primary) transition-colors duration-200 text-sm btn-toggle-comment" data-target={`artalk-saying-${saying.id}`}>
                  <Icon name="material-symbols:chat-bubble-outline" class="text-[18px]" />
                  <span>评论</span>
                </button>
              )}
            </div>

            <!-- Artalk 评论容器（默认隐藏） -->
            {isArtalkEnabled && (
              <div class="mt-3 artalk-comment-wrapper hidden" id={`artalk-saying-${saying.id}`}>
                <div
                  class="saying-artalk-container"
                  id={`artalk-container-${saying.id}`}
                  data-page-key={`/guestbook/saying-${saying.id}`}
                  data-page-title={`${title} #${saying.id}`}
                  style="--at-color-main: var(--primary); --at-color-bg: var(--card-bg); --at-color-border: var(--line-divider);"
                ></div>
              </div>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>
</MainGridLayout>

<style>
  .pl-13 {
    padding-left: 3.25rem;
  }
  .saying-artalk-container :global(.artalk) {
    padding: 0;
  }

  /* Artalk 暗色模式完整适配 */
  .dark .saying-artalk-container {
    --at-color-bg: var(--card-bg);
    --at-color-bg-trans: oklch(0.23 0.015 var(--hue) / 0.8);
    --at-color-bg-second: oklch(0.28 0.015 var(--hue));
    --at-color-bg-second-trans: oklch(0.28 0.015 var(--hue) / 0.8);
    --at-color-text: oklch(0.85 0.01 var(--hue));
    --at-color-text-long: oklch(0.7 0.01 var(--hue));
    --at-color-text-secondary: oklch(0.6 0.01 var(--hue));
    --at-color-text-placeholder: oklch(0.5 0.01 var(--hue));
    --at-color-border: oklch(1 0 0 / 0.08);
    --at-color-border-light: oklch(1 0 0 / 0.05);
    --at-color-primary: var(--primary);
    --at-color-success: oklch(0.7 0.15 145);
    --at-color-danger: oklch(0.65 0.2 25);
  }
</style>

{isArtalkEnabled && (
  <script is:inline define:vars={{ artalkConfigStr, sayingsCount: sayingsData.length }}>
    (function() {
      var config = JSON.parse(artalkConfigStr);
      var artalkInstances = {};

      async function initArtalkForSaying(sayingId, el) {
        if (artalkInstances[sayingId]) return artalkInstances[sayingId];

        var module = await import('https://unpkg.com/artalk/dist/Artalk.mjs');
        var Artalk = module.default;

        var container = document.getElementById('artalk-container-' + sayingId);
        if (!container) return null;

        var instance = Artalk.init({
          server: config.server,
          site: config.site,
          locale: config.locale,
          dark: config.dark,
          el: container,
          pageKey: container.dataset.pageKey,
          pageTitle: container.dataset.pageTitle,
        });

        artalkInstances[sayingId] = instance;
        return instance;
      }

      // 切换评论显示/隐藏
      document.addEventListener('click', function(e) {
        var btn = e.target.closest('.btn-toggle-comment');
        if (!btn) return;

        var targetId = btn.dataset.target;
        var wrapper = document.getElementById(targetId);
        if (!wrapper) return;

        var sayingId = targetId.replace('artalk-saying-', '');
        var isHidden = wrapper.classList.contains('hidden');

        if (isHidden) {
          wrapper.classList.remove('hidden');
          initArtalkForSaying(sayingId);
        } else {
          wrapper.classList.add('hidden');
        }
      });

      // 深色模式同步
      function updateTheme() {
        var isDark = document.documentElement.classList.contains('dark');
        Object.values(artalkInstances).forEach(function(inst) {
          if (inst && inst.setDarkMode) inst.setDarkMode(isDark);
        });
      }

      var observer = new MutationObserver(function() { updateTheme(); });
      observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['class'],
      });
    })();
  </script>
)}
